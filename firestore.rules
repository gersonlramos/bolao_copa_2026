rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users can read/write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Matches are readable by all authenticated users, writable only by functions
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow write: if false; // only Cloud Functions write matches
    }

    // Groups
    match /groups/{groupId} {
      // Any authenticated user can read (needed to find group by invite code before joining)
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Admin can update anything; authenticated users can update only to add themselves
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.adminUserId ||
        (request.auth.uid in request.resource.data.memberIds &&
         request.resource.data.memberIds.hasAll(resource.data.memberIds))
      );
      allow delete: if isAuthenticated() &&
        request.auth.uid == resource.data.adminUserId;

      match /members/{memberId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.adminUserId == request.auth.uid ||
          memberId == request.auth.uid
        );
      }
    }

    // Bets: owner can write, members of same group can read after match finishes
    match /bets/{betId} {
      allow create, update: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
      allow read: if isAuthenticated();
    }

    // Ranking: readable by group members
    match /rankings/{rankingId} {
      allow read: if isAuthenticated();
      allow write: if false; // only Cloud Functions write rankings
    }

    // Login attempts: only functions read/write
    match /loginAttempts/{hash} {
      allow read, write: if false;
    }

    // Download counter: public read, public write (only the stats doc)
    match /config/stats {
      allow read: if true;
      allow write: if true;
    }

    // App version info: public read (checked on startup by all users)
    match /config/appVersion {
      allow read: if true;
      allow write: if false; // only via Firebase Console or admin script
    }
  }
}
